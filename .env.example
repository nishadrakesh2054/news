# Database (Neon PostgreSQL — use pooler URL for app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used in emails, push, sitemaps)
NEXT_PUBLIC_SITE_URL="https://echomanch.com"

# Cloudinary (server-only — never expose API secret to the browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@echomanch.com

# Email via Resend (optional)
RESEND_API_KEY=
MAIL_FROM_EMAIL=info@echomanch.com
MAIL_FROM_NAME=Echo Manch

# Cron jobs (Bearer token for /api/cron/*)
CRON_SECRET="generate-a-long-random-secret"

# Error monitoring (optional — https://sentry.io)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
