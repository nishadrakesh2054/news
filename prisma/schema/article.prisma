enum ArticleStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum ArticleType {
  STANDARD
  BREAKING
  LIVE
  OPINION
  FEATURE
}

enum LanguageEdition {
  BOTH
  NEPALI_ONLY
  ENGLISH_ONLY
}

/** Homepage spotlight layout controlled from admin. */
enum HomeDisplayMode {
  TITLE_ONLY
  TITLE_MEDIA
}

model Article {
  id              String          @id @default(cuid())
  title           String
  titleNp         String?
  slug            String          @unique
  content         String          @db.Text
  contentNp       String?         @db.Text
  excerpt         String?         @db.Text
  excerptNp       String?         @db.Text
  coverImage      String?
  caption         String?
  status          ArticleStatus   @default(DRAFT)
  type            ArticleType     @default(STANDARD)
  languageEdition LanguageEdition @default(BOTH)
  isFeatured      Boolean         @default(false)
  featuredOrder   Int?
  /** Show in homepage spotlight (big title feed). */
  showOnHome      Boolean         @default(false)
  /** TITLE_ONLY = title + author/date; TITLE_MEDIA = + image + excerpt. */
  homeDisplay     HomeDisplayMode @default(TITLE_ONLY)
  homeOrder       Int?
  isBreaking      Boolean         @default(false)
  views           Int             @default(0)
  metaTitle       String?
  metaTitleNp     String?
  metaDescription String?
  metaDescriptionNp String?
  keywords        String?
  keywordsNp      String?
  ogImage         String?
  authorId        String
  author          User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags            Tag[]
  comments        Comment[]
  liveUpdates     LiveUpdate[]
  analyticsEvents AnalyticsEvent[]
  province        Int?
  district        String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, views(sort: Desc)])
  @@index([status, categoryId])
  @@index([status, isFeatured, featuredOrder])
  @@index([status, showOnHome, homeOrder])
  @@index([status, isBreaking, updatedAt(sort: Desc)])
  @@index([status, isBreaking])
  @@index([status, languageEdition])
  @@index([status, type])
  @@index([province])
  @@index([district])
  @@index([authorId])
  @@index([isFeatured, featuredOrder])
  @@index([showOnHome, homeOrder])
  @@index([isBreaking, updatedAt(sort: Desc)])
  @@index([type])
}
