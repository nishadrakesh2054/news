model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  nameNp      String?
  slug        String    @unique
  description String?
  order       Int       @default(0)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
}
