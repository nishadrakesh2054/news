model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  nameNp      String?
  slug        String    @unique
  description   String?
  descriptionNp String?
  order       Int       @default(0)
  /** When false, hidden from public navbar and category listings (articles stay). */
  isActive    Boolean   @default(true)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
  @@index([isActive, order])
}
