enum Role {
  ADMIN
  EDITOR
  AUTHOR
  READER
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?
  image     String?
  role      Role      @default(READER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
  comments  Comment[]
  media     Media[]
}
